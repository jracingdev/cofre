{
  "name": "broquel/cripto",
  "description": "Implementação PHP da criptografia do Broquel, para validar o formato no servidor.",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "ext-sodium": "*",
    "ext-intl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Broquel\\Cripto\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit --do-not-cache-result --colors=never"
  }
}
