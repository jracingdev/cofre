APP_NAME=Broquel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

BROQUEL_SESSAO_MINUTOS=20
BROQUEL_LIMITE_AUTH=8
BROQUEL_LIMITE_API=120
BROQUEL_RP_ID=cofre.exemplo
BROQUEL_ORIGEM=https://cofre.exemplo
# Lista global opcional, separada por vírgula. Vazia não restringe.
BROQUEL_IPS=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15
# SMTP de verdade: veja docs/EMAIL.md

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SaaS (docs/SAAS.md)
BROQUEL_CADASTRO=convite
BROQUEL_MAX_COFRES=0
BROQUEL_PLANO_SEM_REGISTRO=ilimitado
BROQUEL_PLANO_ABERTO=gratis
BROQUEL_CARENCIA_DIAS=7
BROQUEL_TERMOS_VERSAO=2026-11-20
BROQUEL_RESPONSAVEL=jracing.dev.br
BROQUEL_CONTATO=privacidade@jracing.dev.br
BROQUEL_COBRANCA_SEGREDO=
